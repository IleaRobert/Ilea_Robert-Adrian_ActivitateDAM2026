<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Adauga_Imprimanta">


    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Formular Imprimanta noua"
        android:textSize="25sp"
        />

<EditText
    android:id="@+id/textMarca"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="Marca Imprimanta"
    android:textSize="25sp"
    />

    <EditText
        android:id="@+id/textModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Model Imprimanta"
        android:textSize="25sp" />

    <Switch
        android:layout_marginTop="25dp"
        android:id="@+id/switch1"
        android:layout_width="206dp"
        android:layout_height="wrap_content"
        android:text="Este Pornita ?"
        android:textSize="25sp" />

    <CheckBox
        android:id="@+id/checkBox"
        android:layout_marginTop="25dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="25sp"
        android:text="Are WIFI?" />

    <TextView
        android:layout_marginTop="25dp"
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calitate Tiparire"
        android:textSize="25sp"/>

    <RatingBar

        android:id="@+id/ratingBar"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="0.5"

        />

<Button
    android:id="@+id/btnSalvareDate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="200dp"
    android:text="Salveaza Imprimanta"
    android:onClick="culegeDate"
    />


</LinearLayout>